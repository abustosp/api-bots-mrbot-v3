# Ejemplo de entorno para la sección central (despliegue rápido).
# Copiar a .env.central (nunca versionado) y completar. Placeholders, sin secretos reales.

# --- imagen (dev admite tag; prod exige digest) ---
CENTRAL_IMAGE=mrbot-central-api:dev
# Puerto publicado en el host (loopback).
CENTRAL_PORT=8000

# --- base de datos externa (ver db.compose.yaml) ---
# Ejemplo: DATABASE_URL=postgresql+psycopg://mrbot_app:cambiar@host-db:5432/mrbot
DATABASE_URL=

# --- plano de control ---
# Workers permitidos ("ip:puerto", separados por coma). El panel suma en caliente.
# Ejemplo: WORKER_NODES=192.0.2.10:8080,192.0.2.11:8080
WORKER_NODES=
# Alias para el panel: nodo=alias separados por coma (ej: 192.0.2.10:8080=api2).
WORKER_ALIASES=
# Optional target version for fleet badges; blank infers the highest registered version.
WORKER_LATEST_VERSION=
# Versiones del worker desde el registry (automático): repositorio del worker. Con esta variable la
# central consulta los tags AAAAMMDD_HHMMSS, identifica sola la última versión y el panel ofrece un
# desplegable para aplicar una versión puntual (también anterior). Sin ella rige WORKER_IMAGE_REF.
WORKER_IMAGE_REPO=
REGISTRY_USER=
REGISTRY_PASSWORD=
WORKER_REGISTRY_CACHE_SECONDS=60
# Botón "Actualizar" del panel (workers manuales con updater de host).
# Imagen completa que se ordena desplegar (repo:tag o repo@sha256:...). Vacío = deshabilitado.
WORKER_IMAGE_REF=
# Token compartido con los updaters de los hosts (mismo valor en su UPDATER_TOKEN).
UPDATER_TOKEN=
# Workers que se actualizan a la vez en "Actualizar todos".
WORKER_UPDATE_MAX_PARALLEL=1
# Token del panel /admin (mutaciones). Sin él, solo lectura.
ADMIN_TOKEN=
# Secreto HMAC de claves API de clientes (verificación mbk_* + debug en memoria).
API_KEY_HMAC_SECRET=
# Clave privada RSA PEM de custodia en una línea o vacía (dev sin custodia).
# En el stack completo va por secreto rsa_private_key.pem.
RSA_PRIVATE_KEY=
# Firma Ed25519 de asignaciones (vacía = efímera de dev).
ASSIGNMENT_SIGNING_KEY=

# --- OIDC admin (opcional) ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=

# --- relay de workers detrás de NAT (opcional, ver relay.compose.yaml) ---
# Hostname del relay dentro de la red de la central (alias de frps).
RELAY_HOST=relay
# Puertos de túnel asignables a workers (igual a allowPorts de relay/frps.toml).
RELAY_PORT_RANGE=20001-20100
# Dirección pública del frps que verán los frpc (host/IP y puerto de control).
RELAY_PUBLIC_ADDR=
RELAY_PUBLIC_PORT=7000
# Token compartido frps/frpc (openssl rand -hex 32). Lo usa frps y debe llegar
# también a central-api, que lo incluye en el frpc.toml que genera el panel.
FRP_AUTH_TOKEN=
