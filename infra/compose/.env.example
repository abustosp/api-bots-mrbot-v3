# Ejemplo de configuracion por destino para la V3.
# Copiar a .env (nunca versionado) y completar. Los valores aqui son
# placeholders: ningun secreto real se publica como ejemplo.
# Diseno: plans/06-infra/plan.md seccion 6.
#
# Reparto:
#   - El worker no tiene variables de entorno: su config entra por CLI
#     (command: en compose) y todo dato sensible lo provisiona la central
#     por asignación sellada. El token y la clave de verificación llegan
#     en el registro, en memoria.
#   - WORKER_NODES: lo unico que la central necesita saber de los workers
#     (lista de IPs permitidas; el panel /admin/workers suma en caliente).
#   - El resto de secretos va solo a su destino via Docker secrets
#     (archivos bajo ./secrets/, ver docker-compose.yml).

# --- nombre de proyecto (fijo) -------------------------------------------
# compose.yaml solo incluye docker-compose.yml; al invocarlo con
# `docker compose -f compose.yaml` compose NO toma el `name:` del archivo
# incluido y deriva el nombre del directorio ("compose"), levantando un stack
# paralelo al que ya corre. Fijarlo evita contenedores/volumenes duplicados.
COMPOSE_PROJECT_NAME=mrbot-v3

# --- imagenes (dev admite tags; prod exige digest, ver docker-compose.prod.yml)
CENTRAL_IMAGE=mrbot-central-api:dev
WORKER_IMAGE=mrbot-bot-worker:dev
# Release version (tag or git SHA) and optional resolved image digest.
APP_VERSION=3.0.0-dev
WORKER_IMAGE_DIGEST=

# --- postgres (solo host de central; el worker jamas ve estas variables)
POSTGRES_DB=mrbot
POSTGRES_USER=mrbot_app
# DSN que lee Settings (solo desarrollo; en VPS va en secreto database_url).
# Ejemplo: DATABASE_URL=postgresql+psycopg://mrbot_app:cambiar@postgres:5432/mrbot
DATABASE_URL=

# --- central-api: lista de workers permitidos ("ip:puerto", separados por coma)
# Ejemplo: WORKER_NODES=10.0.0.11:8080,10.0.0.12:8080
WORKER_NODES=
# Optional fleet release target. Leave blank to infer the highest registered version.
WORKER_LATEST_VERSION=
# Botón "Actualizar" del panel (workers manuales con updater de host).
# Imagen completa que se ordena desplegar (repo:tag o repo@sha256:...). Vacío = deshabilitado.
WORKER_IMAGE_REF=
# Token compartido con los updaters de los hosts (mismo valor en su UPDATER_TOKEN).
UPDATER_TOKEN=
# Workers que se actualizan a la vez en "Actualizar todos".
WORKER_UPDATE_MAX_PARALLEL=1
# Token del panel de administración (alta/baja de workers). Sin él, las
# mutaciones de /admin/workers son 403; la lectura y el monitoreo siguen abiertos.
ADMIN_TOKEN=

# --- bot-worker: argumentos CLI (el worker no lee .env ni entorno) ---
# En compose van en `command:`; en host dedicado en la línea de arranque
# `python -m bot_worker --central-url ... --advertised-url ...`.
# Solo se documenta la URL anunciada (la central la usa para inspeccionar,
# asignar y consultar). En host dedicado: http://IP:8080.
WORKER_ADVERTISED_URL=
# Numero DNS del worker cuando se publica mediante nginx-v2.
# Cada worker dedicado debe usar su propio proyecto Compose y numero.
WORKER_NUMBER=1
# --- central-api: provisión del worker (sellado + firma) ---
# Clave Ed25519 con la que la central firma asignaciones (solo archivo en
# prod: assignment_signing_key.pem; vacío/placeholder = efímera de dev).
# ASSIGNMENT_SIGNING_KEY= (ver ./secrets/assignment_signing_key.pem)
# Proxy y captcha que la central inyecta por sobre sellado (vacío = sin
# proxy / captcha deshabilitado / endpoints públicos).
# PROXY_ENABLED=false
# PROXY_HOST=
# CUIT_SERVICE_BASE_URL=https://api-constancias-de-inscripcion.mrbot.com.ar/consulta_constancia/
# CUIT_SERVICE_MASIVA_URL=https://api-constancias-de-inscripcion.mrbot.com.ar/consulta_constancia_masiva/
# CUIT_SERVICE_USUARIO= (usuario del servicio de constancias; lo entrega el operador)
# CUIT_SERVICE_API_KEY= (api key del servicio de constancias; va solo en el .env local)
# Para desarrollo sin red contra el servicio real se puede apuntar a
# http://stub-constancias:8081/consulta_constancia/ (perfil ``stub``), que
devuelve una constancia ficticia marcada con ``origen: stub-local``.

# --- central-api: envio de credenciales y avisos por email ---
# La clave va en ./secrets/smtp_password.txt. STARTTLS es obligatorio: sin
# servidor, usuario y clave el alta responde "smtp_no_configurado".
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_FROM= (vacío = SMTP_USER)
# SMTP_STARTTLS=true

# --- Object storage: MEGA S4 (compatible S3, por defecto) ---
# El endpoint publico debe ser alcanzable por el cliente final: las descargas
# redirigen (307) a una URL prefirmada de este host.
OBJECT_STORAGE_ENDPOINT=https://s3.ca-central-1.s4.mega.io
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://s3.ca-central-1.s4.mega.io
OBJECT_STORAGE_REGION=ca-central-1
OBJECT_STORAGE_BUCKET=miscomprobantes
OBJECT_STORAGE_USE_SSL=true
# Credenciales de MEGA S4 (solo central; nunca commitear valores reales):
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- CAPTCHA: una sola clave para todos los portales (solo central) ---
CAPMONSTER_API_KEY=

# --- Proxy dedicado por bot (solo central) ---
# Bots (separados por coma) que salen por un proxy propio porque su portal bloquea las IPs de los servidores.
PROXY_BOTS=
PROXY_BOTS_HOST=
PROXY_BOTS_USERNAME=
PROXY_BOTS_PASSWORD=
PROXY_BOTS_COUNTRY=ar
# Datacenter (un puerto por IP): rango del que la central elige uno por job. Vacio = residencial.
PROXY_BOTS_PORT_MIN=
PROXY_BOTS_PORT_MAX=

# --- secretos solo central (archivos ./secrets/*.txt, nunca en .env real) ---
# database_url.txt: DSN de PostgreSQL para central y job migrate.
# api_key_hmac_secret.txt: verificador de claves API.
# session_signing_key.txt: firma de sesiones del panel admin.
# rsa_private_key.pem: clave privada RSA de credenciales fiscales.
# smtp_password.txt: envio de avisos al administrador.
# minio_central_credentials.txt: reservado (firma de URLs; las claves S3 van en .env).
# postgres_app_password.txt: clave del rol POSTGRES_USER.

# --- secretos solo worker (archivos ./secrets/*.txt, solo si el plugin los usa) ---
# worker_auth_token.txt: identidad del worker ante la central.
# proxy_credentials.txt: usuario y clave del proveedor de proxy.
# capmonster_arca_key.txt: solucionador de CAPTCHA ARCA.
# capmonster_srt_key.txt: solucionador de CAPTCHA SRT.
# cuit_service_key.txt: integracion de consulta de CUIT.
# ai_api_key.txt: funciones de IA, solo si el plugin las conserva.

# --- autoscaler de workers efimeros EC2 (solo central) -----------------------
# Deshabilitado por defecto: con AUTOSCALE_ENABLED=false el panel sigue
# permitiendo altas manuales y bajas (suave o forzada).
AUTOSCALE_ENABLED=false
# true = solo simula decisiones, no lanza ni termina instancias.
AUTOSCALE_DRY_RUN=false
# Umbral de cola sin asignar y tiempo de presion sostenida antes de escalar.
AUTOSCALE_QUEUE_THRESHOLD=10
AUTOSCALE_UP_AFTER_SECONDS=20
# Maximo de instancias efimeras (por zona) y pasos por ciclo (0 = sin limite).
AUTOSCALE_MAX_INSTANCES=4
AUTOSCALE_STEP=0
AUTOSCALE_COOLDOWN_SECONDS=60
AUTOSCALE_IDLE_SECONDS=45
AUTOSCALE_MAX_LIFETIME_SECONDS=7200
# Modo por conteo: 1 worker cada N trabajos pendientes (0 = usa W/S/R/n).
AUTOSCALE_JOBS_PER_WORKER=0
AUTOSCALE_MAX_TOTAL_WORKERS=0
# Region base (la zona elegida en el panel la pisa: bue=us-east-1, sp=sa-east-1).
AUTOSCALE_REGION=sa-east-1
# Tipo por defecto del catalogo (el panel permite elegir cualquiera disponible).
AUTOSCALE_INSTANCE_TYPE=c5.xlarge
# Tamano y tipo de disco raiz. Las Local Zones (Buenos Aires) solo admiten gp2.
AUTOSCALE_VOLUME_GB=30
AUTOSCALE_VOLUME_TYPE=gp3
# Subnets concretas (vacio = descubre las del VPC default, filtradas por zona).
AUTOSCALE_SUBNET_IDS=
# Etiqueta Project de las instancias y nombre del security group. El nombre del
# SG NO se puede compartir entre proyectos de la misma region.
AUTOSCALE_PROJECT_TAG=mrbot-v3-autoscale
AUTOSCALE_SG_NAME=mrbot-autoscale-worker-sg
# Imagen del worker, registry privado y URL central que anuncia el user-data.
AUTOSCALE_WORKER_IMAGE=
AUTOSCALE_REGISTRY_URL=
AUTOSCALE_REGISTRY_USER=
AUTOSCALE_REGISTRY_PASS=
AUTOSCALE_CENTRAL_URL=
AUTOSCALE_WORKER_PORT=8080
# Slots por worker (0 = derivado de la RAM: entre 1,5 y 2 GB por worker,
# sugerido RAM/1,5 y tope duro 10).
AUTOSCALE_WORKER_CONCURRENCY=0
# CIDRs con acceso al puerto del worker (vacio = sin ingress externo).
AUTOSCALE_INGRESS_CIDRS=
# Vida del catalogo de tipos en cache (segundos; describe_instance_types es lento).
AUTOSCALE_CATALOG_TTL_SECONDS=300
# Credenciales AWS del rol/usuario que lanza EC2. Deben incluir
# ec2:RunInstances, ec2:TerminateInstances, ec2:Describe*, ec2:CreateTags,
# ec2:DeleteVolume y ec2:ReleaseAddress (estas dos ultimas, para la limpieza).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# --- backups de la base (solo central) ---------------------------------------
# El dump se hace con COPY de PostgreSQL (no requiere pg_dump), se comprime en
# tar.gz y se sube al bucket con el timestamp en el nombre. Reutiliza el
# endpoint y las credenciales OBJECT_STORAGE_* de arriba.
BACKUP_BUCKET=mrbot-bots-api-bkp-db
BACKUP_PREFIX=dump
# Directorio temporal del dump (se borra al terminar).
BACKUP_DIR=/tmp/mrbot-backups
