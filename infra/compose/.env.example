# Ejemplo de configuracion por destino para la V3.
# Copiar a .env (nunca versionado) y completar. Los valores aqui son
# placeholders: ningun secreto real se publica como ejemplo.
# Diseno: plans/06-infra/plan.md seccion 6.
#
# Reparto:
#   - El worker no tiene variables de entorno: su config entra por CLI
#     (command: en compose) y todo dato sensible lo provisiona la central
#     por asignación sellada. El token y la clave de verificación llegan
#     en el registro, en memoria.
#   - WORKER_NODES: lo unico que la central necesita saber de los workers
#     (lista de IPs permitidas; el panel /admin/workers suma en caliente).
#   - El resto de secretos va solo a su destino via Docker secrets
#     (archivos bajo ./secrets/, ver docker-compose.yml).

# --- imagenes (dev admite tags; prod exige digest, ver docker-compose.prod.yml)
CENTRAL_IMAGE=mrbot-central-api:dev
WORKER_IMAGE=mrbot-bot-worker:dev

# --- postgres (solo host de central; el worker jamas ve estas variables)
POSTGRES_DB=mrbot
POSTGRES_USER=mrbot_app
# DSN que lee Settings (solo desarrollo; en VPS va en secreto database_url).
# Ejemplo: DATABASE_URL=postgresql+psycopg://mrbot_app:cambiar@postgres:5432/mrbot
DATABASE_URL=

# --- central-api: lista de workers permitidos ("ip:puerto", separados por coma)
# Ejemplo: WORKER_NODES=10.0.0.11:8080,10.0.0.12:8080
WORKER_NODES=
# Token del panel de administración (alta/baja de workers). Sin él, las
# mutaciones de /admin/workers son 403; la lectura y el monitoreo siguen abiertos.
ADMIN_TOKEN=

# --- bot-worker: argumentos CLI (el worker no lee .env ni entorno) ---
# En compose van en `command:`; en host dedicado en la línea de arranque
# `python -m bot_worker --central-url ... --advertised-url ...`.
# Solo se documenta la URL anunciada (la central la usa para inspeccionar,
# asignar y consultar). En host dedicado: http://IP:8080.
WORKER_ADVERTISED_URL=
# Numero DNS del worker cuando se publica mediante nginx-v2.
# Cada worker dedicado debe usar su propio proyecto Compose y numero.
WORKER_NUMBER=1
# --- central-api: provisión del worker (sellado + firma) ---
# Clave Ed25519 con la que la central firma asignaciones (solo archivo en
# prod: assignment_signing_key.pem; vacío/placeholder = efímera de dev).
# ASSIGNMENT_SIGNING_KEY= (ver ./secrets/assignment_signing_key.pem)
# Proxy y captcha que la central inyecta por sobre sellado (vacío = sin
# proxy / captcha deshabilitado / endpoints públicos).
# PROXY_ENABLED=false
# PROXY_HOST=
# CUIT_SERVICE_BASE_URL=https://api-constancias-de-inscripcion.mrbot.com.ar/consulta_constancia/
# CUIT_SERVICE_MASIVA_URL=https://api-constancias-de-inscripcion.mrbot.com.ar/consulta_constancia_masiva/
# CUIT_SERVICE_USUARIO= (usuario del servicio de constancias; lo entrega el operador)
# CUIT_SERVICE_API_KEY= (api key del servicio de constancias; va solo en el .env local)
# Para desarrollo sin red contra el servicio real se puede apuntar a
# http://stub-constancias:8081/consulta_constancia/ (perfil ``stub``), que
devuelve una constancia ficticia marcada con ``origen: stub-local``.

# --- central-api: envio de credenciales y avisos por email ---
# La clave va en ./secrets/smtp_password.txt. STARTTLS es obligatorio: sin
# servidor, usuario y clave el alta responde "smtp_no_configurado".
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_FROM= (vacío = SMTP_USER)
# SMTP_STARTTLS=true

# --- secretos solo central (archivos ./secrets/*.txt, nunca en .env real) ---
# database_url.txt: DSN de PostgreSQL para central y job migrate.
# api_key_hmac_secret.txt: verificador de claves API.
# session_signing_key.txt: firma de sesiones del panel admin.
# rsa_private_key.pem: clave privada RSA de credenciales fiscales.
# smtp_password.txt: envio de avisos al administrador.
# mercadopago_access_token.txt: cobros y webhooks.
# minio_central_credentials.txt: firma de URLs para artefactos.
# postgres_app_password.txt: clave del rol POSTGRES_USER.

# --- secretos solo worker (archivos ./secrets/*.txt, solo si el plugin los usa) ---
# worker_auth_token.txt: identidad del worker ante la central.
# proxy_credentials.txt: usuario y clave del proveedor de proxy.
# capmonster_arca_key.txt: solucionador de CAPTCHA ARCA.
# capmonster_srt_key.txt: solucionador de CAPTCHA SRT.
# cuit_service_key.txt: integracion de consulta de CUIT.
# ai_api_key.txt: funciones de IA, solo si el plugin las conserva.
