# Ejemplo de entorno para el worker con relay (worker-relay.compose.yaml).
# Copiar a .env.worker (nunca versionado). Placeholders, sin secretos reales.
# Además de estas variables, requiere ./frpc.toml (se descarga del panel).

WORKER_IMAGE=mrbot-bot-worker:dev
APP_VERSION=3.0.0-dev
WORKER_IMAGE_DIGEST=
WORKER_CONCURRENCY=5

# URL PÚBLICA de la central (register/heartbeat/resultados salen por internet).
CENTRAL_URL=https://central.ejemplo.com
# Dirección del túnel dentro de la red de la central: relay:<puerto asignado en el panel>.
WORKER_ADVERTISED_URL=http://relay:20001

# Token compartido frps/frpc (mismo valor que FRP_AUTH_TOKEN de la central).
FRP_AUTH_TOKEN=
