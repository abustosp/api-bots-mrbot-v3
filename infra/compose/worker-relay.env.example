# Ejemplo de entorno para el worker con relay (worker-relay.compose.yaml).
# Copiar a .env.worker (nunca versionado). Placeholders, sin secretos reales.
# Además de estas variables, requiere ./frpc.toml (se descarga del panel).

WORKER_IMAGE=mrbot-bot-worker:dev
APP_VERSION=3.0.0-dev
WORKER_IMAGE_DIGEST=
WORKER_CONCURRENCY=5

# URL PÚBLICA de la central (register/heartbeat/resultados salen por internet).
CENTRAL_URL=https://central.ejemplo.com
# Dirección del túnel dentro de la red de la central: relay:<puerto asignado en el panel>.
WORKER_ADVERTISED_URL=http://relay:20001

# Token compartido frps/frpc (mismo valor que FRP_AUTH_TOKEN de la central).
FRP_AUTH_TOKEN=

# --- updater de host (opcional, perfil `updater`) ---
# docker compose -f worker-relay.compose.yaml --env-file .env.worker --profile updater up -d
# Habilita el botón "Actualizar" del panel y, con UPDATER_AUTO, la autoactualización.
UPDATER_IMAGE=mrbot-worker-updater:dev
UPDATER_TOKEN=
# Nodo tal como lo ve la central: relay:<puerto> (igual que WORKER_ADVERTISED_URL).
UPDATER_NODE=relay:20001
UPDATER_ALLOWED_REPOS=
# Ruta ABSOLUTA de este directorio en el host.
UPDATER_HOST_DIR=
UPDATER_COMPOSE_NAME=worker-relay.compose.yaml
UPDATER_PROJECT=mrbot-v3-worker-relay
UPDATER_DOCKER_CONFIG=
# 1 = el worker se actualiza solo a la última versión estable (sin -dev); ver services/worker-updater/README.md.
UPDATER_AUTO=
# En la central (opcional): WORKER_UPDATE_AUTO_WINDOW=02:00-05:00, WORKER_UPDATE_AUTO_DRAIN_SECONDS=7200
