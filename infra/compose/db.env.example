# Ejemplo de entorno para la sección db (despliegue rápido).
# Copiar a .env.db (nunca versionado) y completar. Placeholders, sin secretos reales.

# --- postgres ---
POSTGRES_DB=mrbot
POSTGRES_USER=mrbot_app
# Clave del rol POSTGRES_USER (solo despliegue rápido; en el stack completo
# va por Docker secret postgres_app_password).
POSTGRES_PASSWORD=cambiar-en-despliegue
# Puerto publicado en el host (loopback). La central lo usa en DATABASE_URL.
POSTGRES_PORT=5432
