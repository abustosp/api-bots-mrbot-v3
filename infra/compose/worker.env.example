# Ejemplo de entorno para la sección worker (despliegue rápido).
# Copiar a .env.worker (nunca versionado) y completar. Placeholders, sin secretos reales.
# El worker NO lee este archivo como entorno: compose lo usa solo para
# interpolar `command:` (ver worker.compose.yaml).
# No se configura un WORKER_TOKEN estático: central y worker negocian sus
# credenciales de servicio durante el registro, solo en memoria.

# --- imagen (dev admite tag; prod exige digest) ---
WORKER_IMAGE=mrbot-bot-worker:dev
# Release tag or git SHA passed to the worker CLI, not into its environment.
APP_VERSION=3.0.0-dev
# Optional immutable sha256 digest when the deploy system knows the resolved image digest.
WORKER_IMAGE_DIGEST=

# --- registro ante la central (únicos datos del host) ---
# Ejemplo local: CENTRAL_URL=http://central-api:8000
# Ejemplo remoto: CENTRAL_URL=https://central.ejemplo.com
CENTRAL_URL=
# URL propia que el worker anuncia (la central la usa para asignar/inspeccionar).
# En host dedicado: http://IP:8080
WORKER_ADVERTISED_URL=
# Capacidad local: tope duro, jamás mayor a 10 (invariante W-2).
WORKER_CONCURRENCY=5
# Número DNS cuando se publica con nginx-v2 (worker-1, worker-2, ...).
WORKER_NUMBER=1

# --- updater de host (opcional, perfil `updater`): botón "Actualizar" del panel ---
# Activar con: docker compose -f worker.compose.yaml --env-file .env.worker --profile updater up -d
UPDATER_IMAGE=mrbot-worker-updater:dev
# Mismo valor que UPDATER_TOKEN en la central.
UPDATER_TOKEN=
# Nodo tal como figura en la central (host:puerto de WORKER_ADVERTISED_URL).
UPDATER_NODE=
# Repositorios de imagen que el updater acepta desplegar (separados por coma).
UPDATER_ALLOWED_REPOS=
# Ruta ABSOLUTA de este directorio (infra/compose) en el host.
UPDATER_HOST_DIR=
UPDATER_PROJECT=mrbot-v3-worker
# Ruta ABSOLUTA del config.json que dejó `docker login` (credenciales del registry).
UPDATER_DOCKER_CONFIG=

