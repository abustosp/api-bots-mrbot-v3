# Environment variables for the `ccma_compensacion` bot.
# Only variables owned by this bot (prefixed) are listed here.
# Shared utilities (proxy, arca_login, ...) live in shared/.env.

CCMA_COMPENSACION_CLAVE_REPRESENTANTE=
CCMA_COMPENSACION_CUIT_REPRESENTADO=
CCMA_COMPENSACION_CUIT_REPRESENTANTE=

# Compensación de saldos a favor (reafectación de pagos)
# CCMA_COMPENSACION_COMPENSAR=1 -> reafecta los pagos con saldo a favor (default: 1)
# CCMA_COMPENSACION_CONFIRMAR=1 -> confirma las reafectaciones (default: 1)
#                                  con 0 sólo agrega los cambios al detalle
CCMA_COMPENSACION_COMPENSAR=1
CCMA_COMPENSACION_CONFIRMAR=1
