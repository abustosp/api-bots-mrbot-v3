# Environment variables for the `retenciones_agip` bot.
# Only variables owned by this bot (prefixed) are listed here.
# Shared utilities (proxy, arca_login, ...) live in shared/.env.

AGIP_CLAVE=
AGIP_CUIT_REPRESENTADO=
AGIP_DENOMINACION=
AGIP_DESDE=
AGIP_HASTA=
AGIP_USUARIO=

AGIP_HEADLESS=True

# Opcionales (clean/mrbot): subida a MinIO y proxy para pruebas locales.
# El stub local devuelve "minio_disabled" si no se configuran.
AGIP_CARGA_MINIO=False
AGIP_PROXY=False
