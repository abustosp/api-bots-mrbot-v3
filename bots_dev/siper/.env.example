MINIO_URL_INTERNA=
SIPER_CLAVE=
SIPER_CLAVE_REPRESENTANTE=
SIPER_CUIT_REPRESENTADO=
SIPER_CUIT_REPRESENTANTE=

MINIO=False
MINIO_BUCKET_SIPER=siper
MINIO_INTERNO=False
MINIO_SSL=False
