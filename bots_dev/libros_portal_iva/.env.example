# Environment variables for the `libros_portal_iva` bot.
# Only variables owned by this bot (prefixed) are listed here.
# Shared utilities (proxy, arca_login, ...) live in shared/.env.

PORTAL_IVA_LIBROS_CLAVE=
PORTAL_IVA_LIBROS_CUIT_REPRESENTADO=
PORTAL_IVA_LIBROS_CUIT_REPRESENTANTE=
PORTAL_IVA_LIBROS_PERIODOS=
# Operación: descargar (libros + DDJJ) | descargar_libros | descargar_ddjj
PORTAL_IVA_LIBROS_OPERACION=descargar

PORTAL_IVA_LIBROS_HEADLESS=true
