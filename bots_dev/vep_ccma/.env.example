VEP_CCMA_CUIT_REPRESENTANTE=

VEP_CCMA_B64_PDF=false
VEP_CCMA_GENERAR_VOLANTE=true
VEP_CCMA_MEDIO_PAGO=internet_banking
VEP_CCMA_PROXY_REQUEST=false
