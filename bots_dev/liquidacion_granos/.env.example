LIQUIDACION_GRANOS_CLAVE_REPRESENTANTE=
LIQUIDACION_GRANOS_CUIT_REPRESENTANTE=

LIQUIDACION_GRANOS_DENOMINACION=MI EMPRESA
LIQUIDACION_GRANOS_DESDE=01/01/2024
LIQUIDACION_GRANOS_HASTA=31/01/2024
LIQUIDACION_GRANOS_HEADLESS=true
