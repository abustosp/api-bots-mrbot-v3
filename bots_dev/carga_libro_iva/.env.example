# Environment variables for the `carga_libro_iva` bot.
# Only variables owned by this bot (prefixed) are listed here.
# Shared utilities (proxy, arca_login, ...) live in shared/.env.

CARGA_LIBRO_IVA_EXCEL=Lista libros SOS.xlsx
CARGA_LIBRO_IVA_HEADLESS=true
CARGA_LIBRO_IVA_MAX_WORKERS=1
CARGA_LIBRO_IVA_OUTPUT=informe_carga_libro_iva.xlsx
CARGA_LIBRO_IVA_TIMEOUT=600
CARGA_LIBRO_IVA_USE_PROXY_PROPIA=false
